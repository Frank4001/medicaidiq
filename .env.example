# Copy to .env and fill in ONE provider key. Never commit .env.
MEDICAIDIQ_PROVIDER=deepseek          # deepseek | qwen | kimi | local
# MEDICAIDIQ_MODEL=deepseek-flash     # optional override of the provider's default model
# MEDICAIDIQ_BASE_URL=                # optional override (e.g. LM Studio http://127.0.0.1:1234/v1)

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=                    # Qwen via Alibaba Model Studio (International)
MOONSHOT_API_KEY=                     # Kimi
